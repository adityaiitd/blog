{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "X Bookmarks Digest",
  "type": "object",
  "required": ["exported_at", "posts"],
  "properties": {
    "exported_at": { "type": "string" },
    "source": { "type": "string" },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "author_handle", "text", "url"],
        "properties": {
          "id": { "type": "string" },
          "author_name": { "type": "string" },
          "author_handle": { "type": "string" },
          "text": { "type": "string" },
          "url": { "type": "string" },
          "posted_at": { "type": ["string", "null"] },
          "bookmarked_order": { "type": "integer" },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "site_name": { "type": "string" }
              }
            }
          },
          "media": {
            "type": "array",
            "items": { "type": "string" }
          },
          "company_or_topic": { "type": "string" },
          "simple_summary": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "category": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "key_facts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "read_time_seconds": { "type": "integer" }
        }
      }
    }
  }
}
